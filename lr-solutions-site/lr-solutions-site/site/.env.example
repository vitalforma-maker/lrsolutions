# Clé d'accès Web3Forms (https://web3forms.com) — sans clé, le formulaire ouvre un e-mail pré-rempli.
PUBLIC_WEB3FORMS_KEY=
# true = masque tous les marqueurs [À COMPLÉTER] (préproduction présentable)
PUBLIC_HIDE_TODOS=false
# URL de production (canonical, sitemap, Open Graph)
SITE_URL=https://lr-solutions.vercel.app
