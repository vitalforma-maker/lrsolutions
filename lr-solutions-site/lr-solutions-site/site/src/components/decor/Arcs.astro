---
/**
 * Arcs décoratifs des visuels Instagram : quart de cercle vert (haut gauche)
 * et arc or dégradé (bas droit). Masqués sous 768 px.
 */
interface Props {
  haut?: boolean;
  bas?: boolean;
  /** Couleur du quart de cercle haut (vert sur fond clair, or sur fond vert) */
  tonHaut?: "vert" | "or";
}
const { haut = true, bas = true, tonHaut = "vert" } = Astro.props;
const id = `arc-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="pointer-events-none absolute inset-0 hidden overflow-hidden md:block" aria-hidden="true">
  {
    haut && (
      <svg class="absolute -top-px -left-px h-56 w-56 lg:h-72 lg:w-72" viewBox="0 0 200 200">
        {tonHaut === "vert" ? (
          <>
            <path d="M0 0 H170 A170 170 0 0 1 0 170 Z" fill="#29342E" opacity="0.06" />
            <path d="M0 0 H120 A120 120 0 0 1 0 120 Z" fill="#29342E" opacity="0.92" />
            <path d="M0 140 A140 140 0 0 0 140 0" fill="none" stroke="#A68B6D" stroke-width="1.5" />
          </>
        ) : (
          <path d="M0 150 A150 150 0 0 0 150 0" fill="none" stroke="#C9AE8A" stroke-width="1.5" opacity="0.6" />
        )}
      </svg>
    )
  }
  {
    bas && (
      <svg class="absolute -right-px -bottom-px h-56 w-56 lg:h-72 lg:w-72" viewBox="0 0 200 200">
        <defs>
          <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#C9AE8A" />
            <stop offset="1" stop-color="#93785A" />
          </linearGradient>
        </defs>
        <path d="M200 50 A150 150 0 0 0 50 200 H200 Z" fill={`url(#${id})`} opacity="0.85" />
        <path d="M200 20 A180 180 0 0 0 20 200" fill="none" stroke="#A68B6D" stroke-width="1.5" />
      </svg>
    )
  }
</div>
