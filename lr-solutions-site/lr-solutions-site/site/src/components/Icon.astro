---
/**
 * Icônes lucide (trait fin 1,5 px) + Instagram (SVG maison, absent de lucide).
 */
import FileText from "@lucide/astro/icons/file-text";
import ChartColumn from "@lucide/astro/icons/chart-column";
import CalendarDays from "@lucide/astro/icons/calendar-days";
import Coins from "@lucide/astro/icons/coins";
import Scale from "@lucide/astro/icons/scale";
import MessageCircleMore from "@lucide/astro/icons/message-circle-more";
import MapPin from "@lucide/astro/icons/map-pin";
import Users from "@lucide/astro/icons/users";
import Building2 from "@lucide/astro/icons/building";
import Hammer from "@lucide/astro/icons/hammer";
import House from "@lucide/astro/icons/house";
import Briefcase from "@lucide/astro/icons/briefcase";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import Phone from "@lucide/astro/icons/phone";
import Mail from "@lucide/astro/icons/mail";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Check from "@lucide/astro/icons/check";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import Clock from "@lucide/astro/icons/clock";
import UserRound from "@lucide/astro/icons/user-round";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Ear from "@lucide/astro/icons/ear";
import Zap from "@lucide/astro/icons/zap";
import Target from "@lucide/astro/icons/target";
import Lock from "@lucide/astro/icons/lock";
import Eye from "@lucide/astro/icons/eye";
import ListChecks from "@lucide/astro/icons/list-checks";
import Send from "@lucide/astro/icons/send";
import LoaderCircle from "@lucide/astro/icons/loader-circle";
import CircleCheck from "@lucide/astro/icons/circle-check";
import CircleAlert from "@lucide/astro/icons/circle-alert";
import FolderOpen from "@lucide/astro/icons/folder-open";
import Search from "@lucide/astro/icons/search";
import Handshake from "@lucide/astro/icons/handshake";

const icons = {
  "file-text": FileText,
  chart: ChartColumn,
  calendar: CalendarDays,
  coins: Coins,
  scale: Scale,
  message: MessageCircleMore,
  "map-pin": MapPin,
  users: Users,
  building: Building2,
  hammer: Hammer,
  house: House,
  briefcase: Briefcase,
  graduation: GraduationCap,
  phone: Phone,
  mail: Mail,
  "arrow-right": ArrowRight,
  check: Check,
  "chevron-down": ChevronDown,
  menu: Menu,
  x: X,
  clock: Clock,
  user: UserRound,
  shield: ShieldCheck,
  ear: Ear,
  zap: Zap,
  target: Target,
  lock: Lock,
  eye: Eye,
  "list-checks": ListChecks,
  send: Send,
  loader: LoaderCircle,
  "circle-check": CircleCheck,
  "circle-alert": CircleAlert,
  folder: FolderOpen,
  search: Search,
  handshake: Handshake,
} as const;

export type IconKey = keyof typeof icons | "instagram";

interface Props {
  name: IconKey;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className, strokeWidth = 1.5 } = Astro.props;
const Cmp = name === "instagram" ? null : icons[name];
---

{
  Cmp ? (
    <Cmp size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" focusable="false" />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </svg>
  )
}
